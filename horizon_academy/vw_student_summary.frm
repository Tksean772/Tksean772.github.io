query=select `s`.`student_code` AS `student_code`,concat(`s`.`first_name`,\' \',`s`.`last_name`) AS `full_name`,`g`.`grade_name` AS `grade_name`,`c`.`class_name` AS `class_name`,`s`.`status` AS `status`,round(avg(`sc`.`score`),1) AS `avg_score`,case when avg(`sc`.`score`) >= 85 then \'A\' when avg(`sc`.`score`) >= 70 then \'B\' when avg(`sc`.`score`) >= 55 then \'C\' else \'D\' end AS `grade_letter`,`f`.`amount_due` AS `amount_due`,`f`.`amount_paid` AS `amount_paid`,`f`.`amount_due` - `f`.`amount_paid` AS `balance_due`,`f`.`payment_status` AS `payment_status` from ((((`horizon_academy`.`students` `s` join `horizon_academy`.`classes` `c` on(`s`.`class_id` = `c`.`class_id`)) join `horizon_academy`.`grades` `g` on(`c`.`grade_id` = `g`.`grade_id`)) left join `horizon_academy`.`scores` `sc` on(`s`.`student_id` = `sc`.`student_id` and `sc`.`academic_year` = 2024 and `sc`.`term` = \'Term 1\')) left join `horizon_academy`.`fees` `f` on(`s`.`student_id` = `f`.`student_id` and `f`.`academic_year` = 2024 and `f`.`term` = \'Term 1\')) group by `s`.`student_id`,`s`.`student_code`,`s`.`first_name`,`s`.`last_name`,`g`.`grade_name`,`c`.`class_name`,`s`.`status`,`f`.`amount_due`,`f`.`amount_paid`,`f`.`payment_status`
