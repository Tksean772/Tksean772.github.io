source=SELECT\n    s.student_code,\n    CONCAT(s.first_name, \' \', s.last_name)     AS full_name,\n    g.grade_name,\n    c.class_name,\n    s.status,\n    ROUND(AVG(sc.score), 1)                    AS avg_score,\n    CASE\n        WHEN AVG(sc.score) >= 85 THEN \'A\'\n        WHEN AVG(sc.score) >= 70 THEN \'B\'\n        WHEN AVG(sc.score) >= 55 THEN \'C\'\n        ELSE \'D\'\n    END                                         AS grade_letter,\n    f.amount_due,\n    f.amount_paid,\n    (f.amount_due - f.amount_paid)             AS balance_due,\n    f.payment_status\nFROM students s\nJOIN classes  c  ON s.class_id   = c.class_id\nJOIN grades   g  ON c.grade_id   = g.grade_id\nLEFT JOIN scores sc ON s.student_id = sc.student_id AND sc.academic_year = 2024 AND sc.term = \'Term 1\'\nLEFT JOIN fees  f  ON s.student_id = f.student_id  AND f.academic_year  = 2024 AND f.term  = \'Term 1\'\nGROUP BY s.student_id, s.student_code, s.first_name, s.last_name,\n         g.grade_name, c.class_name, s.status,\n         f.amount_due, f.amount_paid, f.payment_status
